cat > .gitignore << 'EOF'
# Virtual environment
rag_env/
env/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ChromaDB
chroma_db/

# Environment variables
.env

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Data files (keep structure but not large PDFs if any)
data/*.pdf
!data/.gitkeep

# Streamlit
.streamlit/secrets.toml
EOF